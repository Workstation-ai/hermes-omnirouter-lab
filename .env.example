# OmniRoute Gateway — Environment Variables
# Copy to .env and edit as needed. All values shown are defaults.

# Gateway port (default: 20128). Change if port is in use.
OMNIROUTE_PORT=20128

# OmniRoute version to install (pinned to 3.8.49).
# 3.8.50 does not exist on npm — do NOT change without verifying availability.
OMNIROUTE_VERSION=3.8.49

# Host to bind OmniRoute to (default: 127.0.0.1 — localhost only).
OMNIROUTE_HOST=127.0.0.1

# Hermes model ID (default: auto — dynamic routing via OmniRoute).
# For stable/reproducible use, pin a >= 128k model:
#   google/gemini-2.5-flash (1M context, free tier)
#   meta-llama/llama-3.3-70b-versatile (128k)
#   openai/gpt-4o-mini (128k)
MODEL_ID=auto
